{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.C. mensuel, version Instagram",
  "type": "object",
  "required": ["mois", "operations"],
  "properties": {
    "mois": {"type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "ex. 2026-11"},
    "depot": {"type": "string"},
    "source": {"type": "string"},
    "thematiques": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nom"],
        "properties": {
          "nom": {"type": "string"},
          "debut": {"type": "string", "format": "date"},
          "fin": {"type": "string", "format": "date"},
          "message": {"type": "string", "description": "message client tel que sur la PLV"}
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "theme", "debut", "fin"],
        "properties": {
          "code": {"type": "string", "description": "ex. OP S45"},
          "theme": {"type": "string"},
          "debut": {"type": "string", "format": "date"},
          "fin": {"type": "string", "format": "date"},
          "categories": {"type": "array", "items": {"type": "string"}},
          "hero_products": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["libelle"],
              "properties": {"ean": {"type": "string"}, "libelle": {"type": "string"}, "prix": {"type": "string"}}
            }
          }
        }
      }
    },
    "temps_forts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nom", "date"],
        "properties": {"nom": {"type": "string"}, "date": {"type": "string", "format": "date"}, "angle": {"type": "string"}}
      }
    },
    "fournisseurs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nom"],
        "properties": {"nom": {"type": "string"}, "debut": {"type": "string"}, "fin": {"type": "string"}, "angle": {"type": "string"}}
      }
    },
    "pros": {"type": "array", "items": {"type": "string"}}
  }
}
